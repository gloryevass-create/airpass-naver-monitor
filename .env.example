# Supabase — 프로젝트 1(airpass-naver-dashboard)과 동일한 프로젝트여야 한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 검색광고(SearchAd) API — https://searchad.naver.com 에서 발급
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=

# 검색결과에서 "우리 순위"를 식별하기 위한 에어패스 자체 도메인 (예: airpass.co.kr)
AIRPASS_DOMAIN=

# 네이버 오픈API(개발자센터, https://developers.naver.com/apps — 무료) — 블로그 검색 API(B2/B3)에 사용.
# 검색광고 API 키와는 별개의 애플리케이션을 등록해서 발급받아야 한다.
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# 공공데이터포털(data.go.kr) "조달청_나라장터 입찰공고정보서비스" 일반 인증키(Encoding).
# 교육청 예산·사업명 모니터링(N2)에 사용. data.go.kr에서 해당 API 활용신청 후 발급되는
# 값을 그대로 붙여넣는다(이미 URL-인코딩된 값 — 재인코딩하지 않는다).
G2B_SERVICE_KEY=

# 유튜브 채널 분석(Y1~Y2) — Google Cloud Console에서 "YouTube Data API v3"를 사용 설정하고
# 발급받은 API 키. OAuth 불필요(공개 채널·영상 통계만 조회). CHANNEL_HANDLE은 @ 없이
# 핸들만 적는다(예: AIRPASS_XR).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=

# 팀 노션(Airpass전략기획 워크스페이스) "행사 및 스케쥴" 데이터베이스 동기화(E1~E2).
# https://www.notion.so/my-integrations 에서 내부 통합(Internal integration)을 만들고,
# 그 통합을 대상 페이지(또는 상위 페이지)에 "연결(Connections)"로 추가해야 접근 가능.
# NOTION_EVENTS_DATABASE_ID는 데이터베이스 페이지 URL의 32자리 하이픈 없는(또는 있는) ID.
NOTION_TOKEN=
NOTION_EVENTS_DATABASE_ID=

# 사업진행 현황(K1~K2) — 같은 Airpass전략기획 워크스페이스의 "사업진행 현황"
# 데이터베이스(영업진행→사업제안→제안서작성→사업수행→사업완료 칸반). 이 데이터베이스에도
# 위 통합(NOTION_TOKEN의 주인)을 "연결(Connections)"로 별도 추가해야 접근 가능하다
# (행사 및 스케쥴과는 별개 페이지라 연결도 별도로 필요).
NOTION_BUSINESS_DATABASE_ID=

# 청소년관련기관DB(F1~F2) — 공공데이터포털 "청소년수련시설정보서비스"(getTeenTrftListV2,
# 여성가족부/한국청소년활동진흥원). data.go.kr에서 활용신청(자동승인) 후 발급되는 일반
# 인증키(Encoding)를 그대로(재인코딩하지 않고) 붙여넣는다. 나라장터(G2B_SERVICE_KEY)와
# 같은 data.go.kr 계정 키를 재사용해도 된다(활용신청만 각각 별도로 필요).
YOUTH_FACILITY_SERVICE_KEY=

# 장애인관련기관(G1~G2) — 공공데이터포털 "전국장애인단체표준데이터"
# (tn_pubr_public_disabled_orgs_api, 보건복지부). data.go.kr에서 활용신청(자동승인) 후
# 발급되는 일반 인증키(Encoding)를 그대로(재인코딩하지 않고) 붙여넣는다. 같은 data.go.kr
# 계정 키를 재사용해도 된다(활용신청만 이 API에 대해 별도로 필요).
DISABILITY_ORG_SERVICE_KEY=

# 장애인체육시설(H1~H2) — 공공데이터포털 "대한장애인체육회_장애인전용체육시설"
# (odcloud.kr 표준 API, namespace 15071029/v1). data.go.kr 활용신청(자동승인) 후 발급되는
# 일반 인증키(Encoding)를 그대로(재인코딩하지 않고) 붙여넣는다. 같은 계정 키 재사용 가능.
DISABILITY_SPORTS_SERVICE_KEY=

# 장애인편의시설(I1~I2, 장애인복지관류 공공시설로 범위 좁힘) — 공공데이터포털
# "전국장애인편의시설표준데이터"(getDisConvFaclList, 한국사회보장정보원). 원본은 전국
# 18만 건(모든 건물)이라 시설명 "장애인" 검색 결과 중 "복지관" 포함분만 취한다
# (scripts/lib/disability-welfare-client.ts 참고). data.go.kr 활용신청(자동승인) 후
# 발급되는 일반 인증키를 그대로 붙여넣는다. 같은 계정 키 재사용 가능.
DISABILITY_WELFARE_SERVICE_KEY=

# 특수학교현황(J1~J2) — 공공데이터포털 "교육부 국립특수교육원_특수학교현황"(odcloud.kr
# 표준 API, namespace 15052682/v1). 전국 196개교 규모라 1회 호출로 전체 수집된다
# (scripts/lib/special-school-client.ts 참고). 같은 계정 키 재사용 가능.
SPECIAL_SCHOOL_SERVICE_KEY=

# 공공기관정보(L1~L2) — 공공데이터포털 "행정안전부_공공기관 웹,모바일웹 사이트 정보"
# (odcloud.kr 표준 API, namespace 15050540/v1). 전국 591개 기관 규모라 1회 호출로
# 전체 수집된다(scripts/lib/public-institution-client.ts 참고). 같은 계정 키 재사용 가능.
PUBLIC_INSTITUTION_SERVICE_KEY=

# 리포트/이상치 판단(A6, A7, B6, B7)에 쓰는 LLM 호출용 (claude -p 헤드리스 실행 시 claude CLI 자체 인증을 쓰므로
# 보통은 비워둬도 되지만, 별도 Anthropic API 키로 스크립트에서 직접 호출하는 방식으로 바꿀 경우 사용)
ANTHROPIC_API_KEY=
