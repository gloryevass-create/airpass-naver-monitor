# Supabase — 프로젝트 1(airpass-naver-dashboard)과 동일한 프로젝트여야 한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 검색광고(SearchAd) API — https://searchad.naver.com 에서 발급
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=

# 검색결과에서 "우리 순위"를 식별하기 위한 에어패스 자체 도메인 (예: airpass.co.kr)
AIRPASS_DOMAIN=

# 네이버 오픈API(개발자센터, https://developers.naver.com/apps — 무료) — 블로그 검색 API(B2/B3)에 사용.
# 검색광고 API 키와는 별개의 애플리케이션을 등록해서 발급받아야 한다.
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# 공공데이터포털(data.go.kr) "조달청_나라장터 입찰공고정보서비스" 일반 인증키(Encoding).
# 교육청 예산·사업명 모니터링(N2)에 사용. data.go.kr에서 해당 API 활용신청 후 발급되는
# 값을 그대로 붙여넣는다(이미 URL-인코딩된 값 — 재인코딩하지 않는다).
G2B_SERVICE_KEY=

# 리포트/이상치 판단(A6, A7, B6, B7)에 쓰는 LLM 호출용 (claude -p 헤드리스 실행 시 claude CLI 자체 인증을 쓰므로
# 보통은 비워둬도 되지만, 별도 Anthropic API 키로 스크립트에서 직접 호출하는 방식으로 바꿀 경우 사용)
ANTHROPIC_API_KEY=
